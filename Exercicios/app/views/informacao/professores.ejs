<!DOCTYPE html>

<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <title>Professores Fatec Sorocaba</title>

    <style>

        table#tabela1 {

            border-collapse: collapse;

        }

        table#tabela1 th,
        table#tabela1 td {

            border: 1px solid black;

            padding: 5px;

        }

        table#tabela1 tr td {

            background: #ffc;

        }

        table#tabela1 tr.cabeca td {

            background: #eee;

        }

    </style>

</head>

<body>

    <h1>Professores da Fatec Sorocaba</h1>

    <table id="tabela1">

        <tr class="cabeca">

            <td>Nome</td>

            <td>E-Mail</td>

        </tr>

        <% console.log('QUANTIDADE DE REGISTROS:' + profs.length); %>

        <% for(let i = 0; i < profs.length; i++){ %>

        <tr>

            <td><%= profs[i].NOME_PROFESSOR %></td>

            <td><%= profs[i].EMAIL_PROFESSOR %></td>

        </tr>

        <% } %>

    </table>

</body>

</html>